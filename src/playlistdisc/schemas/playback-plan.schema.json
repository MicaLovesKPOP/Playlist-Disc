{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playlistdisc.example/schema/playback-plan.schema.json",
  "title": "PDv1 playback plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "format",
    "disc_id",
    "machine_id",
    "title",
    "provider",
    "status",
    "mode",
    "playback"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "format": {
      "const": "PDv1-playback-plan"
    },
    "disc_id": {
      "type": "string",
      "pattern": "^[0-9]{6}$"
    },
    "machine_id": {
      "type": "string",
      "pattern": "^PD1-[0-9]{6}-[0-9]$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "maxLength": 64
    },
    "status": {
      "enum": [
        "ready",
        "partial",
        "ambiguous",
        "requires_lookup",
        "unavailable",
        "unplayable"
      ]
    },
    "mode": {
      "enum": [
        "direct_resource",
        "track_list",
        "entity_lookup",
        "recording_resolution",
        "none"
      ]
    },
    "strategy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "resource": {
      "type": "string",
      "minLength": 1
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lookup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "artist",
            "release_group",
            "canonical_manifest"
          ]
        },
        "musicbrainz_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "recording_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "resolution": {
      "type": "object"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "playback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "start",
        "repeat"
      ],
      "properties": {
        "order": {
          "enum": [
            "ordered",
            "shuffle"
          ]
        },
        "start": {
          "enum": [
            "first",
            "random",
            "resume"
          ]
        },
        "repeat": {
          "enum": [
            "off",
            "context",
            "one"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "direct_resource"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "ready"
          }
        },
        "required": [
          "resource"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "resources"
              ]
            },
            {
              "required": [
                "lookup"
              ]
            },
            {
              "required": [
                "resolution"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "track_list"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "ready",
              "partial",
              "ambiguous"
            ]
          }
        },
        "required": [
          "resources"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "resource"
              ]
            },
            {
              "required": [
                "lookup"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "entity_lookup"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "requires_lookup"
          },
          "lookup": {
            "properties": {
              "type": {
                "enum": [
                  "artist",
                  "release_group"
                ]
              }
            },
            "required": [
              "type",
              "musicbrainz_id"
            ]
          }
        },
        "required": [
          "lookup"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "resource"
              ]
            },
            {
              "required": [
                "resources"
              ]
            },
            {
              "required": [
                "resolution"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "recording_resolution"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "requires_lookup"
          },
          "lookup": {
            "properties": {
              "type": {
                "const": "canonical_manifest"
              }
            },
            "required": [
              "type",
              "recording_count"
            ]
          }
        },
        "required": [
          "lookup"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "resource"
              ]
            },
            {
              "required": [
                "resources"
              ]
            },
            {
              "required": [
                "resolution"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "none"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "ambiguous",
              "unavailable",
              "unplayable"
            ]
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "resource"
              ]
            },
            {
              "required": [
                "resources"
              ]
            },
            {
              "required": [
                "lookup"
              ]
            }
          ]
        }
      }
    }
  ]
}
