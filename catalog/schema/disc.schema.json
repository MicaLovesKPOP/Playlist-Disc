{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playlistdisc.example/schema/disc.schema.json",
  "title": "PDv1 catalog entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "short_title", "status", "definition", "provenance", "lifecycle", "portability", "playback", "tags"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[0-9]{6}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "short_title": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[ -~]+$"},
    "status": {"enum": ["draft", "active", "retired"]},
    "successor": {"type": "string", "pattern": "^[0-9]{6}$"},
    "family": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "definition": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["artist_catalog", "album", "canonical_manifest", "ruleset", "provider_native", "diagnostic"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority"],
      "properties": {
        "authority": {"enum": ["project", "community", "artist", "label", "provider"]},
        "maintainers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "lifecycle": {"enum": ["snapshot", "living"]},
    "portability": {"enum": ["canonical", "federated", "provider_native"]},
    "playback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "start", "repeat"],
      "properties": {
        "order": {"enum": ["ordered", "shuffle"]},
        "start": {"enum": ["first", "random", "resume"]},
        "repeat": {"enum": ["off", "context", "one"]}
      }
    },
    "tags": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
      "uniqueItems": true
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": ["strategy"],
        "properties": {
          "strategy": {"enum": ["materialize", "direct", "equivalent", "best_available", "unsupported"]}
        }
      }
    },
    "notes": {"type": "string"}
  }
}
